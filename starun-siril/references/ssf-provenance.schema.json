{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starun-siril.ssf-provenance.v1",
  "description": "Agent-authored evidence binding one Siril script to the references and optional pinned-manual lookups that informed it. The runtime validates this document but never generates or repairs it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "run_id", "protocol", "script", "references", "command_policy", "manual_lookup", "rationale"],
  "properties": {
    "schema": {"const": "starun-siril.ssf-provenance.v1"},
    "contract_version": {"const": "1"},
    "run_id": {"type": "string", "pattern": "^[0-9]{3}-[a-z0-9][a-z0-9-]{0,63}$"},
    "protocol": {"type": "string", "minLength": 3, "maxLength": 80},
    "script": {"$ref": "#/$defs/scriptBinding"},
    "references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "description": "Paths must also be unique. Exactly one primary item must name the protocol document; runtime enforces these cross-field constraints.",
      "items": {"$ref": "#/$defs/referenceBinding"}
    },
    "command_policy": {"$ref": "#/$defs/hashBinding"},
    "manual_lookup": {"$ref": "#/$defs/manualLookup"},
    "rationale": {"$ref": "#/$defs/rationale"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hashBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": ".*\\S.*"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scriptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^scripts/[0-9]{3}-[a-z0-9][a-z0-9-]{0,63}\\.ssf$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "referenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^references/.*\\S.*"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"enum": ["primary", "supporting"]}
      }
    },
    "manualEvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "^reports/manual-evidence/.*\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "manualLookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "evidence"],
      "properties": {
        "status": {"enum": ["not_needed", "performed"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": ".*\\S.*"},
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/manualEvidenceBinding"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "not_needed"}}, "required": ["status"]},
          "then": {"properties": {"evidence": {"maxItems": 0}}},
          "else": {"properties": {"evidence": {"minItems": 1}}}
        }
      ]
    },
    "rationale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicability", "parameter_choices"],
      "properties": {
        "applicability": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": ".*\\S.*"},
        "parameter_choices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": ".*\\S.*"}
        }
      }
    }
  }
}
