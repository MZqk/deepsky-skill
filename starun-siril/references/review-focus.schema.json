{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "starun-siril.review-focus.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "geometry",
    "previous",
    "areas",
    "none_reason",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "starun-siril.review-focus.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "previous": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "areas": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rect",
          "risks",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "rect": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "risks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "stellar_residual",
                "separation_patch",
                "halo",
                "ringing",
                "flat_core",
                "color_fringe",
                "gray_haze",
                "structure_loss",
                "texture_break",
                "hdr_transition"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": ".*\\S.*"
          }
        }
      }
    },
    "none_reason": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": ".*\\S.*"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
